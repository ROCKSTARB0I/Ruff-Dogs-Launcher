// RuffDogsSetup.exe resources: icon, manifest, version info and the wizard's art (PNG, drawn with GDI+).
#include <windows.h>
LANGUAGE LANG_NEUTRAL, SUBLANG_NEUTRAL
1 ICON "icon.ico"
101 RCDATA "setup-art/side.png"
102 RCDATA "setup-art/wordmark.png"
103 RCDATA "setup-art/dog.png"
LANGUAGE LANG_ENGLISH, SUBLANG_ENGLISH_US
1 RT_MANIFEST "ruffdogs.manifest"
VS_VERSION_INFO VERSIONINFO
FILEVERSION 1,0,0,0
PRODUCTVERSION 1,0,0,0
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904B0"
    BEGIN
      VALUE "CompanyName", "Ruff Dogs Studios"
      VALUE "FileDescription", "Ruff Dogs Setup"
      VALUE "FileVersion", "1.0.0"
      VALUE "InternalName", "RuffDogsSetup"
      VALUE "LegalCopyright", "(c) 2026 Ruff Dogs Studios"
      VALUE "OriginalFilename", "RuffDogsSetup.exe"
      VALUE "ProductName", "Ruff Dogs Launcher"
      VALUE "ProductVersion", "1.0.0"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
